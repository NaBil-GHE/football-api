PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/football_api
CORS_ORIGIN=*

# Authentication (generate a strong random secret of at least 32 characters)
JWT_SECRET=replace-with-a-strong-random-secret-key
JWT_EXPIRES_IN=1d

# Optional: Used only by `npm run seed:admin` to bootstrap the initial admin account
ADMIN_NAME=Football Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-strong-password
